{
  "expo": {
    "name": "Enso",
    "slug": "Enso",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-noalpha.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-noalpha.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aionwebtech.enso",
      "splash": {
        "image": "./assets/splash-noalpha.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.aionwebtech.enso",
      "resizeableActivity": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "jsEngine": "jsc"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "527bfdf4-0fab-4ccf-a179-dce98fec666e"
      }
    }
  }
}
